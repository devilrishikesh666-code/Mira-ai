# Recommended: OpenRouter
OPENROUTER_API_KEY=put_your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/auto

# Optional fallback if OPENROUTER_API_KEY is not set
OPENAI_API_KEY=put_your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Private token for the owner API dashboard
OWNER_DASHBOARD_TOKEN=replace_this_with_a_long_random_secret

# Used as the OpenRouter HTTP-Referer header
APP_URL=http://localhost:3000

PORT=3000
